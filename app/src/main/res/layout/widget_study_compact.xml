<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:gravity="center_vertical"
    android:background="@drawable/widget_study_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_level" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Nivel 3" android:textColor="#F5F9FF" android:textSize="17sp" android:textStyle="bold" android:maxLines="2" />
        <ImageView android:id="@+id/widget_mascot" android:layout_width="33dp" android:layout_height="33dp" android:src="@drawable/mascot_carvier"
            android:scaleType="fitCenter" android:contentDescription="@string/widget_mascot_description" />
    </LinearLayout>
    <TextView android:id="@+id/widget_streak" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Racha: 5 días" android:textColor="#D3E4F8" android:textSize="11sp" android:maxLines="2" />
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
        android:max="500" android:progress="270" android:progressTint="#7EC9FE" android:progressBackgroundTint="#435A77" />
    <TextView android:id="@+id/widget_xp" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="270/500 XP" android:textColor="#D3E4F8" android:textSize="10sp" android:maxLines="2" />
    <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:gravity="center" android:background="@drawable/widget_action_background"
        android:padding="6dp" android:text="Practicar  ›" android:textSize="12sp" android:textStyle="bold" android:textColor="#102846" />
</LinearLayout>