<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_study_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VIALAPP"
                android:textColor="#87CDC4"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1"/>
            <TextView
                android:id="@+id/widget_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nivel 3"
                android:textColor="#F5F9FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_carvier"
            android:contentDescription="@string/widget_mascot_description"/>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Racha: 5 días"
        android:textColor="#F0C888"
        android:textSize="10sp"
        android:maxLines="1"/>
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:max="500"
        android:progress="270"
        android:progressTint="#79CFBE"
        android:progressBackgroundTint="#3D5966"/>
    <TextView
        android:id="@+id/widget_xp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="270/500 XP"
        android:textColor="#BCD2DE"
        android:textSize="10sp"
        android:maxLines="1"/>
    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Misión diaria"
        android:textColor="#E0E8E5"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_action_background"
        android:padding="5dp"
        android:gravity="center"
        android:minHeight="28dp"
        android:text="PRACTICAR ›"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#12303C"/>
</LinearLayout>
